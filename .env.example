# Supabase project (Project Settings → API Keys).
# Key may be publishable (sb_…) or legacy anon (eyJ…); the client accepts both.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Server-only. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=<secret-or-service-role-key>

# App runtime: Transaction pooler (6543). Drizzle connects with prepare:false.
DATABASE_URL=postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Offline tooling (migrate/seed/verify): Session pooler or direct (5432).
DIRECT_URL=postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# E2E test backdoor gate (any random string). Local runs only — NEVER set on
# Vercel: the /auth/test-login route 404s in production builds regardless.
E2E_TEST_SECRET=<random-string-for-local-e2e>

# Shared demo account for one-click login (/auth/demo). Any email works; the
# account is created on first demo login and reseeded with db:seed-demo.
DEMO_EMAIL=demo@example.com
